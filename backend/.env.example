# LUNAR SCOPE backend environment. Copy to .env. Never commit .env or real credentials.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional database (Supabase / PostgreSQL). Leave empty to run without a database.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
